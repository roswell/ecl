## environ can be both symbol and macros
check_symbol_exists(environ "stdlib.h"          HAVE_ENVIRON)
if (NOT HAVE_ENVIRON)
  check_function_exists(environ                 HAVE_ENVIRON2)
  set(HAVE_ENVIRON ${HAVE_ENVIRON2})
endif()

set(ecl_setjmp  ${ECL_SETJMP})
