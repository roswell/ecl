include(CheckFunctionExists)
include(CheckSymbolExists)

# Jmp
set(ECL_SETJMP  "setjmp"  CACHE STRING "setjmp function")
set(ECL_LONGJMP "longjmp" CACHE STRING "longjmp function")

check_function_exists(_longjmp                  HAVE__LONGJMP)

if (HAVE__LONGJMP)
  set(ECL_SETJMP "_setjmp")
  set(ECL_LONGJMP "_longjmp")
endif()

check_function_exists(pthread_mutex_timedlock   HAVE_PTHREAD_MUTEX_TIMEDLOCK)
